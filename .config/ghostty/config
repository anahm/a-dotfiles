# Ghostty config — migrated from iTerm2 Default profile
# Generated 2026-03-16

# Font
font-family = Monaco
font-size = 13

# Colors — Solarized Light
background = #FDF6E3
foreground = #657B83
cursor-color = #657B83
cursor-text = #FDF6E3
selection-background = #EEE8D5
selection-foreground = #586E75

# ANSI palette
palette = 0=#073642
palette = 1=#DC322F
palette = 2=#859900
palette = 3=#B58900
palette = 4=#268BD2
palette = 5=#D33682
palette = 6=#2AA198
palette = 7=#EEE8D5
palette = 8=#002B36
palette = 9=#CB4B16
palette = 10=#586E75
palette = 11=#657B83
palette = 12=#839496
palette = 13=#6C71C4
palette = 14=#93A1A1
palette = 15=#FDF6E3

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
# Ghostty doesn't support a truly unlimited scrollback buffer yet,
# so use a large per-surface limit as a practical approximation.
scrollback-limit = 536870912

# Bell
bell-features = no-system,no-audio,no-attention

# Window
window-inherit-working-directory = true
background-opacity = 1.0

# Splits (remapped from iTerm2 muscle memory)
# Cmd+K default (clear_screen) moved to Cmd+Shift+K
keybind = super+k=new_split:right
keybind = super+j=new_split:down
keybind = super+shift+k=clear_screen
